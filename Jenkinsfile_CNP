#!groovy

@Library("Infrastructure@2.4.4")

def type = "ruby"
def product = "et-pet"
def component = "ccd-export"

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)
def rubyBuilder = new uk.gov.hmcts.contino.RubyBuilder(this)

def installRuby = {
    sh script:"""#!/bin/bash -l
        set +x
        source /usr/local/rvm/scripts/rvm
        echo "Installing Ruby on \$(lsb_release -ds)"
        rvm --version
        rvm install ruby-3.3.5 --autolibs=read-only
        rvm use ruby-3.3.5 --default
    """, label: 'Ruby version install'
}

def useBundlePathOutsideWorkspace = {
    def bundlePath = "${pwd(tmp: true)}/bundle"

    sh script:"""#!/bin/bash -l
        set +x
        source /usr/local/rvm/scripts/rvm
        rvm use
        set -x

        bundle config set path "${bundlePath}"
        bundle install --jobs=4 --retry=3
        rm -rf vendor/bundle
    """, label: 'Use bundle path outside workspace'
}

withPipeline(type, product, component) {
    env.RAILS_ENV = 'test'
    env.DB_HOST = 'localhost'
    env.DB_USER = 'postgres'
    env.DB_PORT = '5421'
    env.DB_PASSWORD = 'postgres'
    env.ENABLE_COVERAGE = 'true'
    before('build') {
        yarnBuilder.runYarn("--mutex network install --frozen-lockfile")
        installRuby()
    }
    afterSuccess('build') {
        useBundlePathOutsideWorkspace()
    }
    before('functionalTest:preview') {
        installRuby()

        useBundlePathOutsideWorkspace()
    }
    before('smoketest:preview') {
        installRuby()

        useBundlePathOutsideWorkspace()
    }
    before('test') {
        sh script:"""
            docker stop pet-et-ccd-export-test-postgres && docker rm pet-et-ccd-export-test-postgres || echo 'Ignoring failure in stopping old postgres'
            docker run --rm --name pet-et-ccd-export-test-postgres --publish 5421:5432 -e POSTGRES_PASSWORD=postgres -d postgres
        """, label: 'Start test postgres'

        rubyBuilder.bundle("exec rails db:create db:migrate")
    }
}
